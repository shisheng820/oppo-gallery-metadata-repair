# ExifTool custom mdta key observed in OnePlus camera MP4 files.
# Pass -config profiles/oplus-video.config BEFORE other ExifTool options.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::QuickTime::Keys' => {
        'com.oplus.product.model' => {
            Name => 'OplusProductModel',
            Writable => 'string',
        },
    },
);
1;
